<Project>

  <PropertyGroup>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- Los avisos de seguridad de paquetes (NU1901-NU1904) se muestran, pero no detienen la compilación:
         dependen de una base de datos externa que cambia sin que cambie el código, y un aviso nuevo
         dejaría de compilar un commit que ayer compilaba. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" />
    <PackageReference Include="SonarAnalyzer.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoMapper 14.x: DoS por recursión sin límite al mapear grafos muy anidados.
         Se acepta el riesgo para no arrastrar AutoMapper 15+ (licencia comercial, deps .NET 10).
         Mitigación: usar .MaxDepth(n) en mapeos de tipos autorreferenciados. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6vhm-j9h7-f9gh" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gpwp-5797-mjff" />
  </ItemGroup>

</Project>